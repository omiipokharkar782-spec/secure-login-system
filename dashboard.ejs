<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard</title><link rel="stylesheet" href="/style.css"></head><body><main class="card"><div class="brand">🔐 SecureAuth</div><div class="avatar">✓</div><h1>Welcome, <%= user.name %>!</h1><p class="muted">You are successfully logged in.</p><section class="details"><p><strong>Account email</strong><br><%= user.email %></p><p><strong>Authentication status</strong><br><span class="status">Authenticated</span></p></section><form method="post" action="/logout"><button class="secondary" type="submit">Log out</button></form><p class="footnote">Your session is protected by an HTTP-only cookie.</p></main></body></html>
