<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Log in</title><link rel="stylesheet" href="/style.css"></head><body><main class="card"><div class="brand">🔐 SecureAuth</div><h1>Welcome back</h1><p class="muted">Log in to your account.</p><% if (registered) { %><div class="success">Account created successfully. You can now log in.</div><% } %><% if (errors.length) { %><div class="alert"><% errors.forEach(e => { %><p><%= e.msg %></p><% }) %></div><% } %><form method="post" action="/login"><label>Email address<input type="email" name="email" required autocomplete="email"></label><label>Password<input type="password" name="password" required autocomplete="current-password"></label><button type="submit">Log in</button></form><p class="bottom">New here? <a href="/register">Create an account</a></p></main></body></html>
